# Coach3 Environment Variables Configuration
ENVIRONMENT=development
PORT=8000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://coach:coach_secret@localhost:5432/coach3_dev
POSTGRES_USER=coach
POSTGRES_PASSWORD=coach_secret
POSTGRES_DB=coach3_dev
POSTGRES_PORT=5432

# Cryptography - 32 url-safe base64-encoded bytes for Fernet token encryption at rest
# Generate a new key with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=

# Polar AccessLink API Credentials (https://admin.polaraccesslink.com)
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_REDIRECT_URI=http://localhost:8000/api/v1/integrations/polar/callback

# Concept2 Logbook API Credentials (https://log.concept2.com/developers)
CONCEPT2_CLIENT_ID=
CONCEPT2_CLIENT_SECRET=
CONCEPT2_REDIRECT_URI=http://localhost:8000/api/v1/integrations/concept2/callback

# Background Sync Schedule (minutes)
SYNC_INTERVAL_MINUTES=60
