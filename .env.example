# Coach3 Environment Variables Configuration
ENVIRONMENT=development
PORT=8000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://coach:coach_secret@localhost:5432/coach3_dev
POSTGRES_USER=coach
POSTGRES_PASSWORD=coach_secret
POSTGRES_DB=coach3_dev
POSTGRES_PORT=5432

# Cryptography (REQUIRED) - 32 url-safe base64-encoded bytes for Fernet token encryption at rest
# Generate a new key with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Single-User Passphrase Authentication
# Set a strong passphrase for homelab / LAN access (required whenever deployed beyond localhost).
COACH3_PASSPHRASE=
# Optional pre-hashed scrypt passphrase (takes precedence over COACH3_PASSPHRASE if set)
COACH3_PASSPHRASE_HASH=
# Local development convenience ONLY: allows loopback (127.0.0.1/::1) requests without login
# when ENVIRONMENT=development. Ignored in production and for non-loopback clients.
AUTH_DISABLED_LOCALHOST=true

# Web Security & Reverse Proxy
# Comma-separated trusted browser origins for CORS (empty = same-origin only; never use '*')
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Set to true only when running behind a trusted HTTPS reverse proxy (Caddy/Nginx/Traefik/Tailscale)
TRUST_PROXY_HEADERS=false
# Optional comma-separated allowlist of hostnames/IPs for local llama.cpp endpoints
ALLOWED_LLM_HOSTS=
# Optional comma-separated personal terms (e.g., athlete name, city) to scrub before cloud LLM calls
SCRUB_TERMS=

# Polar AccessLink API Credentials (https://admin.polaraccesslink.com)
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_REDIRECT_URI=http://localhost:8000/api/v1/integrations/polar/callback

# Concept2 Logbook API Credentials (https://log.concept2.com/developers)
CONCEPT2_CLIENT_ID=
CONCEPT2_CLIENT_SECRET=
CONCEPT2_REDIRECT_URI=http://localhost:8000/api/v1/integrations/concept2/callback

# Background Sync Schedule (minutes) & Pool Limits
SYNC_INTERVAL_MINUTES=60
SYNC_PAGE_LIMIT=50
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_STATEMENT_TIMEOUT_MS=30000
